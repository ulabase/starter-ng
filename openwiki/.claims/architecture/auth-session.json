        }
      ]
    },
    {
      "id": "claim_4f5e2c1fecdc49568300262b67a0b990",
      "statement": "checkSession() also loads teams: with no stored token it short-circuits to null with empty teams and makes no HTTP call, otherwise it fetches the user and then the teams. login() likewise loads teams in the same round trip. Screens depend on this — the home page reads the active team without calling loadTeams() because authGuard already ran checkSession().",
      "evidence": [
        {
          "resource": "repo://PORTING.md#L56-L62",
          "version": "repo-lines-v1:sha256:b5df779614ad83c964492e369516dfcf03b0b29e310758f4c930b17209f626c6:"
