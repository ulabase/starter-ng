    {
      "id": "claim_52a09de3054c444588c3eaa07deff62f",
      "statement": "authGuard runs checkSession() and redirects to /auth/login when there is no user; publicGuard is the inverse and is applied to every auth screen so a signed-in user cannot land on the login form. The authenticated shell root route is canActivate: [authGuard].",
      "evidence": [
        {
          "resource": "repo://PORTING.md#L74-L77",
