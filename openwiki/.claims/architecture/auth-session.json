    {
      "id": "claim_a6b81d92408c46c3965f2fbf9aade184",
      "statement": "The bearer token is persisted by the kit layer (app code hands it to setToken and reads it with getToken), while RhAuthService exposes session state to Angular as signals — user(), teams(), and isAuthenticated() — which components read instead of parsing the token. Because the token is browser-side, the authenticated shell cannot be server-rendered and is declared RenderMode.Client.",
      "evidence": [
        {
          "resource": "repo://PORTING.md#L37-L46",
          "version": "repo-lines-v1:sha256:f5e480a7ac740caac300bdb757cec16b2934bdd28f9161a0715c9bee66e1917c:"
