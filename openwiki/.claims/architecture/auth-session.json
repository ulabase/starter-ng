    {
      "id": "claim_3dc754d0cf0441448cbc8989c96cc76f",
      "statement": "consumeFragmentToken() runs in the App constructor on the browser platform before routing settles: it parses #access_token from the URL hash, stores it with setToken and starts silent renewal with scheduleRefresh, reads the one-shot ?flow=signup marker, and clears both from the URL bar with history.replaceState.",
      "evidence": [
        {
          "resource": "repo://src/app/app.ts#L64-L68",
