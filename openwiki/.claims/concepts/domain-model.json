    {
      "id": "claim_c3978bbd5c534964b083aa374c3f3e5a",
      "statement": "Feature flags live once in `src/environments/environment*.ts` and must match the service's Sign-up Mgmt Features toggles (`emailRegistration`→Registration/Verification, `passwordReset`→Password Reset, `oauthLogin`→Google sign-in, `oauthProviders`→configured providers, `teamInvitations`→Team Invitations); a feature that is off on the server returns 403 to unauthenticated users, so offering UI for it creates dead ends. The setup tooling derives the server toggles from the same file (`registration`/`verification` from `emailRegistration`, `password-reset` from `passwordReset`, `invitations` from `teamInvitations`, `oauth` from `oauthLogin`), and `app.routes.ts` builds routes from the same flags so a false flag removes the route entirely.",
      "evidence": [
        {
          "resource": "repo://src/app/app.routes.ts#L21-L21",
          "version": "repo-lines-v1:sha256:94653facfa422aa108ac31aa5a02a920779a3603b928ebb70024c9ecc54aa65a:"
        },
