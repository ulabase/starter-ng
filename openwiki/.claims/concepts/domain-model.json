    {
      "id": "claim_e68f2a1a3b374ed89be775f23731873b",
      "statement": "A user is identified by email: `user._id` **is** the email address, and the display name lives in a nested profile at `user.profile.name` / `user.profile.surname`. The shell reads both and falls back to `_id` when the profile is empty — `displayName()` joins name and surname else returns `_id`, `initials()` takes the first character of each name part else the first character of `_id`, and `email()` returns `user._id` directly.",
      "evidence": [
        {
          "resource": "repo://PORTING.md#L43-L43",
          "version": "repo-lines-v1:sha256:97aae4eb1511152fe35ec75cb69be18249210d004daa4791e1d7454aaa980969:"
        },
        {
