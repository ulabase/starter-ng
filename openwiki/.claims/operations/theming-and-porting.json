        }
      ]
    },
    {
      "id": "claim_307a58f7702f4376832f13db0fedd697",
      "statement": "src/index.html runs an inline bootstrap script that reads localStorage['rh-theme'] and applies the .dark class to document.documentElement before Angular boots, avoiding a flash of the wrong theme. The storage key must stay in sync with STORAGE_KEY in theme.service.ts, and the lookup is wrapped because localStorage throws when storage is blocked.",
      "evidence": [
