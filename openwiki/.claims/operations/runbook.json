        }
      ]
    },
    {
      "id": "claim_3df2946830fb4c0ab592a00e36d055b2",
      "statement": "The origin-allowlist setup step adds `APP_URL` to the service's `allowed-origins` and never replaces the list, so a service reached from several origins keeps them all; changing where the app is served from requires re-running `ulabase setup` or adding the origin under Service → Origin Allowlist.",
      "evidence": [
        {
          "resource": "repo://README.md#L95-L98",
          "version": "repo-lines-v1:sha256:68c291b82ece04ea2219e81e0c1266104bb3e79f38e15f63925b8cd86d692d9d:"
