  "claims": [
    {
      "id": "claim_6e567ad899c046ee821aaea770ce4d3e",
      "statement": "The package.json scripts wrap the Angular CLI (`start` → `ng serve`, `build` → `ng build`, `watch` → `ng build --watch --configuration development`, `test` → `ng test`) and add `serve:ssr:ulabase-starter-ng`, which runs `node dist/ulabase-starter-ng/server/server.mjs`. The starter requires Node.js 22.18 or later and declares `@ulabase/kit-ng` and `@ulabase/cli` at `^0.15.0`, `vitest` `^4.0.8` and `jsdom` `^28.0.0` as devDependencies, with Vitest globals enabled via `tsconfig.spec.json`.",
      "evidence": [
        {
          "resource": "repo://README.md#L27-L31",
          "version": "repo-lines-v1:sha256:78efb76d2fa86bd771f4f8b3f342bca1aadb83b1649e29a0368ee777ddf5e78d:"
