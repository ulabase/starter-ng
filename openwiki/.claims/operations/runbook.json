        }
      ]
    },
    {
      "id": "claim_664787045dfb491a9851974872cd2f14",
      "statement": "The SSR entry `src/server.ts` is an Express 5 app that serves `../browser` static assets with a 1-year cache and delegates remaining requests to `AngularNodeAppEngine`; it listens on `PORT` or defaults to 4000, starting when the module is the main entry or under PM2.",
      "evidence": [
        {
          "resource": "repo://src/server.ts#L25-L52",
          "version": "repo-lines-v1:sha256:65d0baad94f12f1f809eb5d546ca46be43f2ed3d26655daf82b9b2a9ba28e68c:"
        }
      ]
    },
    {
      "id": "claim_cd7a8d5917624c899ee1600ef919ddff",
      "statement": "SSR render modes in `app.routes.server.ts` must mirror the client routes in `app.routes.ts` (a mismatch fails the SSR build); public auth pages are `Prerender`, while `auth/verify`, the invitation paths, the authenticated shell, and the catch-all are `Client` because they depend on an API call or the browser-held token.",
      "evidence": [
        {
          "resource": "repo://angular.json#L28-L34",
          "version": "repo-lines-v1:sha256:6fa0d83ae7f9a97d406b630dbb7337f9deec944f9cf642f6b400f5e509a65334:"
