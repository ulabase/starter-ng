        }
      ]
    },
    {
      "id": "claim_007535eec05d45b1933b7fb208856970",
      "statement": "A plain `fetch` to the Ulabase service carries no session and returns 401; custom calls must use `auth.api()`, which attaches the bearer token. The kit's interceptor clears the session on 401/expiry, and the token has a 15-minute TTL with silent refresh at about 80%.",
      "evidence": [
        {
          "resource": "repo://PORTING.md#L64-L66",
          "version": "repo-lines-v1:sha256:ec9a7efbd103bd869f137ee9a91d15531a0d2f9ba6a3d696d0631a66d3902fd8:"
