    {
      "id": "claim_a63c5cb1b9544f9883739e611956edec",
      "statement": "`ulabase setup` steps are check-then-apply and idempotent (`--dry-run` reports gaps without writing), and run in the order accounts feature install, branding name, accounts config (`frontend-url` / `frontend-app-url` and derived feature toggles), conditional Google OAuth credentials, origin-allowlist, and `appPointsAtService` last; `APP_URL` comes from `process.env.APP_URL` and defaults to `http://localhost:4200`.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts",
          "version": "repo-file-v1:sha256:d6e7ac8abd76049c11571e0a72b263e011908d2b201bb18ceb463bb6a58da24e"
        },
        {
