    {
      "id": "claim_f299a0dde765449d9e0047eac5fbfab9",
      "statement": "Feature flags in `environment*.ts` must match the service's Sign-up Mgmt → Features toggles: a feature that is off on the server returns 403 to unauthenticated users, and `ulabase setup` derives the server's toggles from `environment.dev.ts` so re-running setup reconciles them.",
      "evidence": [
        {
          "resource": "repo://README.md#L96-L102",
          "version": "repo-lines-v1:sha256:f52fa7842a0b51af0091fe9423e45c3d74790e3a5a16c332e649aa8cdec683a5:"
