    {
      "id": "claim_0cee71ee8c094a0ba280a0c6600c4e73",
      "statement": "The `ConsentsGate` component in `src/app/consents-gate.ts` sits outside the router outlet so it renders even when `authGuard` blocks navigation, covers the app with an acceptance form while the API answers `451`, and calls `auth.acceptConsents()` then does a pathname-aware reload: redirects to `/` when on an auth page, otherwise reloads the current URL so in-progress flows like invitation acceptance are preserved.",
      "evidence": [
