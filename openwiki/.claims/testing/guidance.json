    {
      "id": "claim_3f5eca522f5b4abe86482c5d56bab15b",
      "statement": "Public auth routes (login, signup, forgot-password, reset-password) are prerendered via RenderMode.Prerender. The verify page, both invitation paths, and the authenticated shell use RenderMode.Client because they need live API calls or a browser-stored token. Server routes in app.routes.server.ts must mirror the conditional client routes or SSR route extraction fails at build time.",
      "evidence": [
        {
          "resource": "repo://src/app/app.routes.server.ts#L1-L59",
          "version": "repo-lines-v1:sha256:adebe88d84dbf59586844b3085a89bf830efc12cdb386d9c57b82ce1f11a182b:"
        }
      ]
    },
    {
      "id": "claim_550831db943f41b9b00a0192fa7b068f",
      "statement": "Bearer-token delivery is verified in DevTools with three checks: (1) auth.api() calls carry an `Authorization: Bearer …` request header, (2) the verify redirect returns `#access_token` in the URL fragment captured by consumeFragmentToken in app.ts, and (3) activate, reset-password, and switch-team use `?delivery=body` to return access_token in the same response with no follow-up POST /token.",
      "evidence": [
