    {
      "id": "claim_275c207762d1429ba9f498616192e6f9",
      "statement": "Unit tests run via `npm test` (alias for `ng test`), which uses the `@angular/build:unit-test` builder to execute Vitest. `tsconfig.spec.json` enables `vitest/globals` types and includes `src/**/*.spec.ts`. There is no separate Vitest configuration file — the Angular CLI builder owns discovery and execution.",
      "evidence": [
        {
          "resource": "repo://angular.json#L80-L82",
