    {
      "id": "claim_d16ceb94045a457197636ee520354cf6",
      "statement": "The ulabase setup tooling consists of two files that share one accounts definition: ulabase.setup.ts installs and configures the accounts feature (registration, verification, password reset, OAuth, team invitations derived from environment.dev.ts), writes APP_NAME into the branding feature, configures Google OAuth credentials when offered, installs the origin-allowlist feature for the app origin, and runs appPointsAtService last to write the service URL into environment.dev.ts; ulabase.setup.consents.ts imports those accounts steps and appends the consents gate (user schema, users collection binding, own-consents PATCH permission, JWT claims on the auth feature, and a guards rule) before also running appPointsAtService last.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L183-L321",
          "version": "repo-lines-v1:sha256:2a289b5a8ccdd0b92625d8ce587c47a0494725ae046b2508608e84910a9a52df:"
