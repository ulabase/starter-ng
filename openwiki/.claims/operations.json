    {
      "id": "claim_7a0ce9e486754a04aa1718f2e5e0f793",
      "statement": "Feature-config updates in ulabase.setup.ts use read-modify-write: the current config is read first and spread into the update so the server's redaction placeholders (bullets) are passed straight back and stored secrets are preserved; stripping empty-looking fields would overwrite a real secret.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L141-L160",
          "version": "repo-lines-v1:sha256:4e1678900ca99a9a554fccea3745b3b86fb5ff7e789ead079714cbf19b90b4e5:"
        }
