    {
      "id": "claim_2dba22d6637b4d129fac7a235e47fab0",
      "statement": "Feature installs in ulabase.setup.ts treat HTTP 409 (Plugin already installed) as success and rethrow any other API error, so a forced apply against an already-configured service reports no spurious failure.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L73-L81",
