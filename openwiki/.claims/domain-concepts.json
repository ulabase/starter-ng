    {
      "id": "claim_40f2d2359b2349bd87b972f60d9eb984",
      "statement": "The invitation flow at /invitations/accept handles three scenarios: new users (set password then activate), existing logged-out users (login then acceptInvite), and existing logged-in users (acceptInvite directly). Invitations carry email + token as query params validated by getInvitation(). When getToken() is truthy, the component calls checkSession() to restore the session. If getInvitation() returns 404 for a signed-in user, the component redirects to '/' (handling the case where a user returns to an already-accepted invitation after a consents gate reload).",
      "evidence": [
        {
          "resource": "repo://src/app/app.routes.ts#L68-L77",
          "version": "repo-lines-v1:sha256:a0e08cf0f6bf26fcb69e2b38c7c3a7c6e63fea38c2f2c3661070a13babd2f995:"
