    {
      "id": "claim_a51f69ca0e03441fbc9514205402345c",
      "statement": "The consents gate setup in ulabase.setup.consents.ts configures four server-side documents: a user schema (userConsentsSchema) with latestConsents and consents fields, collection validation attaching it to /users, a permission (userCanPatchOwnConsents) that stamps versions via mergeRequest, and a Guards rule (consentsGate) that blocks non-compliant users with 451. It also adds two JWT claim paths via the auth feature config and installs the guards feature.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.consents.ts#L189-L218",
          "version": "repo-lines-v1:sha256:085be38d75c84e7159d44906ead70176328ff245623f0f097cee224f0a16e7ba:"
