    {
      "id": "claim_bcd5ae7fb5d34c7b82a5f5ede1a8aeb7",
      "statement": "The ulabase setup tooling (ulabase.setup.ts) installs the accounts plugin, configures feature flags derived from environment.dev.ts, sets OAuth credentials if enabled, and adds the app origin to the CORS allowlist. It follows a check/apply pattern for idempotent runs.",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L1-L131",
