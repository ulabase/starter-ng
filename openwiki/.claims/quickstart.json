    {
      "id": "claim_bcd5ae7fb5d34c7b82a5f5ede1a8aeb7",
      "statement": "The ulabase setup tooling (ulabase.setup.ts) follows a check/apply pattern for idempotent runs and executes steps in this order: accounts plugin install, branding name (APP_NAME env, default \"Ulabase Starter\", read-modify-write preserving console-set color/logo), accounts config with frontend-url/frontend-app-url and feature toggles derived from environment.dev.ts, conditional Google OAuth credentials (only when oauthLogin is on and oauthProviders includes 'google'), origin-allowlist (app origin added, never replaced), and appPointsAtService last (writes apiUrl into environment.dev.ts only once everything above is in place).",
      "evidence": [
        {
          "resource": "repo://ulabase.setup.ts#L1-L48",
          "version": "repo-lines-v1:sha256:62610f22b14dc8956d4bc2529eec91569b2eae63f4e3c031334e5085af32fae0:"
        },
        {
