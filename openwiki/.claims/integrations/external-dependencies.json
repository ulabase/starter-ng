    {
      "id": "claim_e94f0ab7141f4519b573fc0c50cba73e",
      "statement": "Declared versus resolved versions is an invariant: package.json declares @ulabase/kit-ng and @ulabase/cli at ^0.15.0, while package-lock.json resolves @ulabase/kit-ng, @ulabase/kit, and @ulabase/cli each to 0.15.0; @ulabase/kit is a transitive dependency of both kit-ng and cli, and kit-ng 0.15.0 requires Angular >=21 and rxjs >=7 as peer dependencies. The lockfile is the source of truth for installed versions and package.json for the declared range.",
      "evidence": [
        {
          "resource": "repo://package-lock.json#L19-L30",
