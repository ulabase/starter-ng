          "version": "repo-lines-v1:sha256:39099982a972ecdcc8b17c013d929277756717a7f7dd2883f5d1fc88fffad7b2:"
        }
      ]
    },
    {
      "id": "claim_5884dd25cdf84a38adeba36aa858d548",
      "statement": "On app start in the browser, consumeFragmentToken() stores a fragment `access_token` with setToken(), starts silent renewal with scheduleRefresh, raises the justSignedUp signal from the one-shot `?flow=signup` query marker, and strips both from the URL bar with history.replaceState before route guards run.",
      "evidence": [
        {
          "resource": "repo://src/app/app.ts#L17-L41",
          "version": "repo-lines-v1:sha256:adb8d2d17347f17c2db747d5776a83202f5d4d8785b9710c444b8468e80e6aa7:"
        }
      ]
    },
    {
      "id": "claim_c588690a879644faa89ddb7409288f33",
      "statement": "justSignedUp is an in-memory one-shot flag raised for any fresh signup (email verification or OAuth), copied and immediately reset by the Shell so the welcome banner cannot reappear on a later login; because it is shared with OAuth, the banner copy must not claim an email was verified.",
      "evidence": [
        {
          "resource": "repo://src/app/just-signed-up.ts#L3-L9",
