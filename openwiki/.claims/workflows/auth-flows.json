          "version": "repo-lines-v1:sha256:c247d1e488cdf2378d27a242314979c068d1b9e1390ab0d2122184d729e14a2a:"
        }
      ]
    },
    {
      "id": "claim_83f04ac133b54d9c923616df502a495d",
      "statement": "The verify page performs no client-side token exchange: on construction it calls auth.verify(email, token), which returns a redirect URL that the browser is sent to via window.location.href; that redirect carries the new session as `#access_token=...` in the URL fragment with no follow-up POST /token.",
      "evidence": [
        {
          "resource": "repo://TEST-CASES.md#L12-L14",
          "version": "repo-lines-v1:sha256:1eaa25836584c38d63e19e01bd7b5ab272ae9f05642abc3618a862709e6da1c4:"
        },
        {
