    {
      "id": "claim_3d28380dabb04a2fb3449b08c93949b3",
      "statement": "Email signup calls auth.register with an auto-generated team name (`${firstName}'s Team`, or the email local part when the first name is empty) because the API requires a teamName but the form does not collect one; a 409 is shown as \"An account with this email already exists.\" and a successful submit only shows the check-your-email panel — the user is not signed in until the emailed link is used.",
      "evidence": [
        {
          "resource": "repo://src/app/pages/auth/signup/signup.html#L2-L7",
          "version": "repo-lines-v1:sha256:6c871f36dc02988633877cd45eede2dad7bf8e7627b894710af3f831dc6fc46b:"
        },
        {
